+#-------------------------------------------------------------------------
+do_execsql_test 6.0 {
+  CREATE VIRTUAL TABLE t6 USING fts3(a, b, c, d);
+  INSERT INTO t6 VALUES(
+      'one two three A', 'one two three B', 'one two three C', 'one two three D'
+  );
+}
+
+proc do_snip_test {name query iCol nTok lRes} {
+  set q "'[string map {' ''} $query]'"
+  set    SQL "SELECT snippet(t6, '{', '}', '...', $iCol, $nTok) "
+  append SQL " FROM t6 WHERE t6 MATCH $q"
+  uplevel [list do_execsql_test $name $SQL [list $lRes]]
+}
+
+do_snip_test 6.1 two 0 5  {one {two} three A}
+do_snip_test 6.2 two -1 5 {one {two} three A}
+do_snip_test 6.3 two 3 5  {one {two} three D}
+do_snip_test 6.4 two 4 5  {}
+
+# The 5th argument to snippet() is a column index. A negative value means
+# any column may be used, and a value greater than or equal to the number
+# of columns in the table means there is no such column and the result is
+# an empty string. Test that this is still true if the value passed in is
+# too large to be represented as a 32-bit integer.
+do_snip_test 6.5 two -4294967293 5 {one {two} three A}
+do_snip_test 6.6 two 4294967299  5 {}
+
 set sqlite_fts3_enable_parentheses 0
 finish_test
