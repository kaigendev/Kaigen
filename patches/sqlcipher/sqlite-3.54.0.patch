+  sqlite3_vtab_cursor *cur,
+  sqlite3_int64 *pRowid
+){
+  vec1cat_cursor *pCur = (vec1cat_cursor *)cur;
+  *pRowid = pCur->iRowid;
+  return SQLITE_OK;
+}
