+  REPLACE INTO t5 VALUES(2, 4, 5);
+} {
+  DELETE main t5 0 0  2.0 10.0 3
+  INSERT main t5 0 0  2.0 4.0 5
+}
+do_preupdate_test 3.2.4 {
+  DELETE FROM t5;
+} {
+  DELETE main t5 0 0  2.0 4.0 5
+}
+
