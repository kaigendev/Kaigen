+static int vec1RollbackMethod(sqlite3_vtab *pVtab){
+  Vec1Tab *pTab = (Vec1Tab*)pVtab;
+  vec1UnloadModel(pTab);
+  return vec1FinishWriter(pTab, 1);
+}
