+  /* Scalar tail for cases where the number of dimensions is not 
+  ** divisible by 4. */
+  for(; d<nElem; d++){
+    for(cc=0; cc<VEC1_MULTIMATCH_NCENT; cc++){
+      float cent = aCent[cc*nElem+d];
+      for(vv=0; vv<VEC1_MULTIMATCH_NVEC; vv++){
