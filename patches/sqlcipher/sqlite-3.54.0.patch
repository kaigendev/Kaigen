+** Return true if either the SQLITE_NO_COLOR compile-time option is used
+** or if the NO_COLOR environment variable exists
+*/
+static int shellNoColor(void){
+#if defined(SQLITE_NO_COLOR) || defined(SQLITE_SHELL_FIDDLE)
