+      case '"': case '`': case '\'':
+        if( zEsc ){
+          switch( *z ){
+            case 'b': *oz++ = '\b'; break;
+            case 'n': *oz++ = '\n'; break;
+            case 'r': *oz++ = '\r'; break;
+            case 't': *oz++ = '\t'; break;
+              /* No \f or \v. Nobody uses those. And no \0 because
