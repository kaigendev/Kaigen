+CMPP__EXPORT(cmpp_size_t, cmpp_count_nl)(unsigned char const *zBegin,
+                                         unsigned char const * const zEnd,
+                                         unsigned char const * const zPos,
+                                         cmpp_size_t *pCol){
+  assert( zPos >= zBegin );
+  assert( zPos <= zEnd );
+  unsigned char const * z = zBegin;
+  cmpp_size_t nl = 0, col = 0;
+  while( z < zPos ){
+    switch( *z ){
+      case '\n': ++nl; col = 0; break;
+      default: ++col; break;
+    }
+    ++z;
+  }
+  if( pCol ) *pCol = col;
+  return nl;
+}
