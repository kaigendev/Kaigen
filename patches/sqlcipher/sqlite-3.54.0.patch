+CMPP__EXPORT(void, cmpp_tizer_errpos_set)(cmpp_tizer *tz,
+                                          unsigned char const *z){
+  if( z ){
+    if( cmpp_tizer_contains(tz, z) ){
+      tz->errToken = cmpp_token_empty;
+      tz->errToken.z = tz->errToken.zInner = z;
+    }/*else{
