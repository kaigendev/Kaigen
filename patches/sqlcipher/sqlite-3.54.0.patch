+static int vec1SqlExec(Vec1Tab *pTab, const char *zSqlfmt, char **pzErr){
+  char *zSql = 0;
+  int rc = SQLITE_OK;
+
+  zSql = sqlite3_mprintf(zSqlfmt, pTab->zDb, pTab->zName);
+  if( zSql==0 ){
+    rc = SQLITE_NOMEM;
+  }else{
+    rc = sqlite3_exec(pTab->db, zSql, 0, 0, pzErr);
+    sqlite3_free(zSql);
+  }
+
+  return rc;
+}
