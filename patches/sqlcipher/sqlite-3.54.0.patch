+  const float *aVec[VEC1_MULTIMATCH_NVEC],
+  const float *aCent,             /* VEC1_MULTIMATCH_NCENT packed centroids */
+  float *aDistIn,
+  int *aBestIn
+){
+  float32x4_t aAcc[VEC1_MULTIMATCH_NVEC][VEC1_MULTIMATCH_NCENT];
