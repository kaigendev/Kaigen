+# vec1 loadable extension.
+#
+# If VEC1_AVX2 is non-zero (the default, except when targeting ARM),
+# vec1.c is compiled twice - once with scalar code and once with AVX2 -
+# and both objects linked into a single DLL that picks one at runtime
+# based on the CPU. Otherwise a single scalar-only build is done.
+#
+!IFNDEF VEC1_AVX2
+!IF "$(PLATFORM)"=="arm" || "$(PLATFORM)"=="ARM" || "$(PLATFORM)"=="arm64" || "$(PLATFORM)"=="ARM64"
+VEC1_AVX2 = 0
+!ELSEIF "$(VSCMD_ARG_TGT_ARCH)"=="arm" || "$(VSCMD_ARG_TGT_ARCH)"=="arm64"
+VEC1_AVX2 = 0
+!ELSE
+VEC1_AVX2 = 1
+!ENDIF
+!ENDIF
+
+VEC1_SRC = $(TOP)\ext\vec1\vec1.c
+
+!IF $(VEC1_AVX2)!=0
+vec1.dll:	$(VEC1_SRC) $(SQLITE3H)
+	$(TCC) -DVEC1SIMD=SCALAR -Fovec1scalar.lo -Fdvec1.pdb -c $(VEC1_SRC)
+	$(TCC) -DVEC1SIMD=AVX2 -arch:AVX2 -Fovec1avx2.lo -Fdvec1.pdb -c $(VEC1_SRC)
+	$(LD) $(LDFLAGS) $(LTLINKOPTS) $(LTLIBPATHS) /DLL /OUT:$@ vec1scalar.lo vec1avx2.lo
+!ELSE
+vec1.dll:	$(VEC1_SRC) $(SQLITE3H)
+	$(TCC) -Fovec1.lo -Fdvec1.pdb -c $(VEC1_SRC)
+	$(LD) $(LDFLAGS) $(LTLINKOPTS) $(LTLIBPATHS) /DLL /OUT:$@ vec1.lo
+!ENDIF
+
