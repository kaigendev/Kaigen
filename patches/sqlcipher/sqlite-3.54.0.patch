+      let pBackup;
+      try{
+        dbSrc.exec([
+          "CREATE TABLE t(id INTEGER PRIMARY KEY, val TEXT);",
+          "INSERT INTO t(val) VALUES('alpha'), ('beta'), ('gamma'), ('delta');"
+        ]);
