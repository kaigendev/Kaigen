+  SELECT sum(rowid) FROM vvv;
+} {5050000000000}
+
+do_execsql_test 4.1 {
+  INSERT INTO vvv(cmd, arg) VALUES('rebuild', '{index:"flat"}');
+} {}
+
+do_execsql_test 4.2 {
