+static void vec1AnnResultSelect(Vec1AnnResult *aArr, int nArr, int K){
+  int iLeft = 0;
+  int iRight = nArr-1;
+  while (iLeft <= iRight) {
+    size_t iPivot = vec1AnnResultPartition(aArr, iLeft, iRight);
+    if( iPivot==K ){
