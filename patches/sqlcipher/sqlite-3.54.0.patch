+/*
+** Allocate and return a zeroed buffer nByte bytes in size.
+*/
+static void *vec1MallocZero(i64 nByte){
+  void *pRet = sqlite3_malloc64(nByte);
+  if( pRet ){
+    memset(pRet, 0, nByte);
+  }
+  return pRet;
+}
