+#-------------------------------------------------------------------------
+# Test that the values passed to the preupdate hook for columns with
+# REAL affinity are always FLOAT values, even if the value is one that
+# could be stored as an integer without loss of data.
+#
+#   3.1.* - INSERT, UPDATE and DELETE on a rowid table.
+#   3.2.* - INSERT, UPDATE and DELETE on a WITHOUT ROWID table with a
+#           REAL PRIMARY KEY.
+#
+do_execsql_test 3.0 {
+  CREATE TABLE t4(a REAL, b REAL DEFAULT 5);
+  CREATE TABLE t5(a REAL PRIMARY KEY, b REAL, c) WITHOUT ROWID;
+}
+
+do_preupdate_test 3.1.1 {
+  INSERT INTO t4 VALUES(7, 7.0);
+} {
+  INSERT main t4 1 1  7.0 7.0
+}
+do_preupdate_test 3.1.2 {
+  INSERT INTO t4(a) VALUES('-12');
+} {
+  INSERT main t4 2 2  -12.0 5.0
+}
+do_preupdate_test 3.1.3 {
+  INSERT INTO t4 SELECT a+1, 'abc' FROM t4 WHERE rowid=1;
+} {
+  INSERT main t4 3 3  8.0 abc
+}
+do_preupdate_test 3.1.4 {
+  UPDATE t4 SET b=b*2 WHERE rowid=1;
+} {
+  UPDATE main t4 1 1  7.0 7.0  7.0 14.0
+}
+do_preupdate_test 3.1.5 {
+  DELETE FROM t4 WHERE rowid=2;
+} {
+  DELETE main t4 2 2  -12.0 5.0
+}
+do_execsql_test 3.1.6 {
+  SELECT typeof(a), typeof(b) FROM t4 ORDER BY rowid;
+} {real real real text}
+do_preupdate_test 3.1.7 {
+  UPDATE t4 SET a=5 WHERE rowid=3;
+} {
+  UPDATE main t4 3 3  8.0 abc  5.0 abc
+}
+
+do_preupdate_test 3.2.1 {
+  INSERT INTO t5 VALUES(1, 2, 3);
+} {
+  INSERT main t5 0 0  1.0 2.0 3
+}
+do_preupdate_test 3.2.2 {
+  UPDATE t5 SET a=a+1, b=10 WHERE a=1;
+} {
+  UPDATE main t5 0 0  1.0 2.0 3  2.0 10.0 3
