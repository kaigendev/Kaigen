+  //tzSub->name = cmpp_tizer_name(tzParent);
+  cmpp_tizer_init(tzSub, tzParent->err, tok->zInner, tok->nInner);
+}
+
+CMPP__EXPORT(void, cmpp_tizer_dtor)(cmpp_tizer * tz){
+  *tz = cmpp_tizer_empty;
