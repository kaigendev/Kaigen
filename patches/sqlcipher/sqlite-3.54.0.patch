+#-------------------------------------------------------------------------
+# Test that highlight() and snippet() handle column-number arguments that
+# are too large or too small to fit in a 32-bit signed integer in the
+# same way as other out-of-range values of the same sign.
+#
+reset_db
+do_execsql_test 15.0 {
+  CREATE VIRTUAL TABLE t1 USING fts5(a, b);
+  INSERT INTO t1 VALUES('one two three', 'four five six');
+}
+
+foreach {tn iCol} {
+  1  2
+  2  -1
+  3  2147483648
+  4  -2147483649
+  5  4294967295
+  6  4294967296
+  7  4294967297
+  8  -4294967295
+  9  -4294967296
+  10 9223372036854775807
+  11 -9223372036854775808
+} {
+  do_execsql_test 15.1.$tn {
+    SELECT quote(highlight(t1, $iCol, '[', ']')) FROM t1('one OR five');
+  } {''}
+}
+
+foreach {tn iCol} {
+  1  -1
+  2  -2147483649
+  3  -4294967295
+  4  -4294967296
+  5  -9223372036854775808
+} {
+  do_execsql_test 15.2.$tn {
+    SELECT snippet(t1, $iCol, '[', ']', '...', 5) FROM t1('five');
+  } {{four [five] six}}
+}
+
+foreach {tn iCol} {
+  1  2
+  2  2147483648
+  3  4294967295
+  4  4294967296
+  5  4294967297
+  6  9223372036854775807
+} {
+  do_catchsql_test 15.3.$tn {
+    SELECT snippet(t1, $iCol, '[', ']', '...', 5) FROM t1('one OR five');
+  } {1 {column index out of range}}
+}
+
 finish_test
