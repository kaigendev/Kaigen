+{
+    if (policy == SHARED_KEY_BUDGET_STRICT_SOURCE
+            && (net_family_is_ipv4(source_ip->family)
+                || net_family_is_ipv6(source_ip->family))) {
+        return NET_SHARED_KEY_IP_SOURCE_BURST;
+    }
+
