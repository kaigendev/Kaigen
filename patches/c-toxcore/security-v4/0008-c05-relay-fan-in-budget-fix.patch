+static bool shared_key_budget_source_equal(const IP *a, const IP *b)
+{
+    if (net_family_is_tcp_client(a->family) || net_family_is_tcp_client(b->family)) {
+        return net_family_is_tcp_client(a->family)
+               && net_family_is_tcp_client(b->family)
+               && a->ip.v6.uint64[0] == b->ip.v6.uint64[0]
+               && a->ip.v6.uint64[1] == b->ip.v6.uint64[1];
+    }
+
+    return ip_equal(a, b);
+}
