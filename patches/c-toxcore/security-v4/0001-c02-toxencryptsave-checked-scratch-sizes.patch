 static const char *pw = "hunter2";
 static unsigned int pwlen = 7;
 
+typedef struct Rejecting_Memory {
+    Memory mem;
+    uint32_t allocation_count;
+} Rejecting_Memory;
+
+static void *rejecting_malloc(void *user_data, uint32_t size)
+{
+    (void)size;
+    Rejecting_Memory *rejecting = (Rejecting_Memory *)user_data;
+    ++rejecting->allocation_count;
+    return nullptr;
+}
+
+static void *rejecting_realloc(void *user_data, void *ptr, uint32_t size)
+{
+    (void)ptr;
+    (void)size;
+    Rejecting_Memory *rejecting = (Rejecting_Memory *)user_data;
+    ++rejecting->allocation_count;
+    return nullptr;
+}
+
+static void rejecting_dealloc(void *user_data, void *ptr)
+{
+    (void)user_data;
+    (void)ptr;
+}
+
+static const Memory_Funcs rejecting_memory_funcs = {
+    rejecting_malloc,
+    rejecting_realloc,
+    rejecting_dealloc,
+};
+
 /* cause I'm shameless */
 static void accept_friend_request(Tox *m, const uint8_t *public_key, const uint8_t *data, size_t length, void *userdata)
 {
@@ -202,11 +237,85 @@ static void test_keys(void)
     tox_pass_key_free(key);
 }
 
+static void test_checked_lengths(void)
+{
+    const uint8_t one = 1;
+    uint8_t output = 0xa5;
+    Tox_Err_Encryption encerr;
+    Tox_Err_Decryption decerr;
+    Tox_Err_Key_Derivation keyerr;
+    Tox_Pass_Key *key = tox_pass_key_derive(&one, 1, &keyerr);
+    ck_assert_msg(key != nullptr, "pass key allocation failure: %u", keyerr);
+
+    const size_t rejected_plaintext_lengths[] = {
+        (size_t)INT32_MAX - CRYPTO_MAC_SIZE + 1,
+        (size_t)UINT32_MAX,
+        SIZE_MAX,
+    };
+
+    for (size_t i = 0; i < sizeof(rejected_plaintext_lengths) / sizeof(rejected_plaintext_lengths[0]); ++i) {
+        output = 0xa5;
+        ck_assert(!tox_pass_key_encrypt(key, &one, rejected_plaintext_lengths[i], &output, &encerr));
+        ck_assert(encerr == TOX_ERR_ENCRYPTION_FAILED);
+        ck_assert(output == 0xa5);
+
+        ck_assert(!tox_pass_encrypt(&one, rejected_plaintext_lengths[i], &one, 1, &output, &encerr));
+        ck_assert(encerr == TOX_ERR_ENCRYPTION_FAILED);
+        ck_assert(output == 0xa5);
+    }
+
+    const size_t rejected_ciphertext_lengths[] = {
+        (size_t)INT32_MAX + TOX_PASS_ENCRYPTION_EXTRA_LENGTH - CRYPTO_MAC_SIZE + 1,
+        (size_t)UINT32_MAX,
+        SIZE_MAX,
+    };
+
+    for (size_t i = 0; i < sizeof(rejected_ciphertext_lengths) / sizeof(rejected_ciphertext_lengths[0]); ++i) {
+        output = 0xa5;
+        ck_assert(!tox_pass_key_decrypt(key, &one, rejected_ciphertext_lengths[i], &output, &decerr));
+        ck_assert(decerr == TOX_ERR_DECRYPTION_INVALID_LENGTH);
+        ck_assert(output == 0xa5);
+
+        ck_assert(!tox_pass_decrypt(&one, rejected_ciphertext_lengths[i], &one, 1, &output, &decerr));
+        ck_assert(decerr == TOX_ERR_DECRYPTION_INVALID_LENGTH);
+        ck_assert(output == 0xa5);
+    }
+
+    Rejecting_Memory rejecting = {
+        {&rejecting_memory_funcs, nullptr},
+        0,
+    };
+    rejecting.mem.user_data = &rejecting;
+
+    const uint8_t shared_key[CRYPTO_SHARED_KEY_SIZE] = {0};
+    const uint8_t nonce[CRYPTO_NONCE_SIZE] = {0};
+
+    ck_assert(encrypt_data_symmetric(&rejecting.mem, shared_key, nonce, &one,
+                                     (size_t)INT32_MAX - CRYPTO_MAC_SIZE, &output) == -1);
+    ck_assert(rejecting.allocation_count == 2);
+
+    rejecting.allocation_count = 0;
+    ck_assert(encrypt_data_symmetric(&rejecting.mem, shared_key, nonce, &one,
+                                     (size_t)INT32_MAX - CRYPTO_MAC_SIZE + 1, &output) == -1);
+    ck_assert(rejecting.allocation_count == 0);
+
+    rejecting.allocation_count = 0;
+    ck_assert(decrypt_data_symmetric(&rejecting.mem, shared_key, nonce, &one, INT32_MAX, &output) == -1);
+    ck_assert(rejecting.allocation_count == 2);
+
+    rejecting.allocation_count = 0;
+    ck_assert(decrypt_data_symmetric(&rejecting.mem, shared_key, nonce, &one, (size_t)INT32_MAX + 1, &output) == -1);
+    ck_assert(rejecting.allocation_count == 0);
+
+    tox_pass_key_free(key);
+}
+
 int main(void)
 {
     setvbuf(stdout, nullptr, _IONBF, 0);
     test_save_friend();
     test_keys();
+    test_checked_lengths();
 
     return 0;
 }
