+static bool checked_add_size(size_t lhs, size_t rhs, size_t *_Nonnull result)
+{
+    if (lhs > SIZE_MAX - rhs) {
+        return false;
+    }
+
+    *result = lhs + rhs;
+    return true;
+}
+
+static bool valid_encryption_lengths(size_t plaintext_len)
+{
+    size_t ciphertext_len;
+    size_t encrypted_len;
+
+    return checked_add_size(plaintext_len, TOX_PASS_ENCRYPTION_EXTRA_LENGTH, &ciphertext_len)
+           && ciphertext_len > plaintext_len
+           && checked_add_size(plaintext_len, crypto_box_MACBYTES, &encrypted_len)
+           && encrypted_len <= INT32_MAX;
+}
+
+static bool valid_decryption_lengths(size_t ciphertext_len)
+{
+    if (ciphertext_len <= TOX_PASS_ENCRYPTION_EXTRA_LENGTH) {
+        return false;
+    }
+
+    const size_t plaintext_len = ciphertext_len - TOX_PASS_ENCRYPTION_EXTRA_LENGTH;
+    size_t encrypted_len;
+
+    return checked_add_size(plaintext_len, crypto_box_MACBYTES, &encrypted_len)
+           && encrypted_len <= INT32_MAX;
+}
