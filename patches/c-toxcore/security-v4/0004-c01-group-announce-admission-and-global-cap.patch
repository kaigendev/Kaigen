+/** Internal announce retry policy shared by self and group-chat announces. */
+static inline uint32_t onion_client_announce_path_for_retry(uint32_t path_used,
+        uint8_t pings_since_last_response, bool long_lived)
+{
+    if (pings_since_last_response == ONION_NODE_MAX_PINGS - 1 && long_lived) {
+        return UINT32_MAX;
+    }
+
+    return path_used;
+}
+
+/** Keep status 2 private to an authenticated group-chat announce response. */
+static inline uint8_t onion_client_normalize_announce_status(uint32_t num,
+        bool is_groupchat, uint16_t gc_data_length, uint8_t is_stored)
+{
+    return num > 0 && is_groupchat && gc_data_length != 0 && is_stored == 2
+           ? 0
+           : is_stored;
+}
