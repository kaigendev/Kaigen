diff --git a/toxcore/net_crypto.c b/toxcore/net_crypto.c
index 9496fba203777e95bb0ba18e18d4625a5213e78e..225c07597a3e222a1a12b9e3bcc86552144c4fa4 100644
--- a/toxcore/net_crypto.c
