+#define NET_SHARED_KEY_SOURCE_RATE 16U
+#define NET_SHARED_KEY_SOURCE_BURST 32U
+#define NET_SHARED_KEY_SOURCE_CAP 1024U
+#define NET_SHARED_KEY_ITERATION_CAP 64U
+
+#define NET_SHARED_KEY_TOKEN_UNITS 1000U
