+typedef struct Shared_Key_Work_Budget {
+    Shared_Key_Source_Budget sources[NET_SHARED_KEY_SOURCE_CAP];
+    uint64_t global_refill_ms;
+    uint32_t global_token_units;
+    uint16_t iteration_remaining;
+    uint16_t source_count;
+    uint16_t lru_head;
