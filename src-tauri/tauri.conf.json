{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kaigen",
  "mainBinaryName": "Kaigen",
  "version": "0.2.7",
  "identifier": "io.github.kaigendev.kaigen",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "create": true,
        "title": "Kaigen",
        "width": 1180,
        "height": 720,
        "minWidth": 860,
        "minHeight": 560,
        "center": true,
        "backgroundColor": "#050a10",
        "visible": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost asset: http://asset.localhost",
        "font-src": "'self' data:",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'",
        "frame-src": "'none'",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "manifest-src": "'self'",
        "media-src": "'self' asset: http://asset.localhost blob:",
        "object-src": "'none'",
        "script-src": "'self'",
        "script-src-attr": "'none'",
        "style-src": "'self' 'unsafe-inline'",
        "worker-src": "'self'",
        "require-trusted-types-for": "'script'",
        "trusted-types": "kaigen-spellcheck-worker"
      },
      "devCsp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost asset: http://asset.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420",
        "font-src": "'self' data:",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'",
        "frame-src": "'none'",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "manifest-src": "'self'",
        "media-src": "'self' asset: http://asset.localhost blob:",
        "object-src": "'none'",
        "script-src": "'self'",
        "script-src-attr": "'none'",
        "style-src": "'self' 'unsafe-inline'",
        "worker-src": "'self'",
        "require-trusted-types-for": "'script'",
        "trusted-types": "kaigen-spellcheck-worker"
      },
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
