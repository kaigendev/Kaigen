{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kaigen",
  "version": "0.1.1",
  "identifier": "com.duke.tox-pq-client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "create": true,
        "title": "Kaigen",
        "width": 1180,
        "height": 720,
        "minWidth": 860,
        "minHeight": 560,
        "center": true,
        "backgroundColor": "#050a10",
        "visible": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
