      "command": "node scripts/test-chat-geometry-runtime.mjs --avatar-only"
    },
    "test:settings-export-ui": {
      "by": "test:chat-geometry-runtime",
      "reason": "Full geometry runner includes Settings qTox export races, failures and Blob URL lifecycle.",
      "command": "node scripts/test-chat-geometry-runtime.mjs --settings-export-only"
    },
    "test:spellcheck-ui": {
      "by": "test:chat-geometry-runtime",
      "reason": "Full geometry runner includes controlled spellcheck races and native dictionary failure/recovery scenarios.",
      "command": "node scripts/test-chat-geometry-runtime.mjs --spellcheck-only"
    },
    "test:settings-password-ui": {
      "by": "test:chat-geometry-runtime",
      "reason": "Full geometry runner includes password scenarios.",
      "command": "node scripts/test-chat-geometry-runtime.mjs --settings-password-only"
    },
