      "by": "test:chat-geometry-runtime",
      "reason": "Full geometry runner includes all onboarding scenarios.",
      "command": "node scripts/test-chat-geometry-runtime.mjs --onboarding-only"
    }
  },
  "controlAliases": [
    "test:full-current"
  ],
  "nonLeafAliases": [
    {
      "alias": "test:pq-faults",
      "command": "node scripts/extended-native-verification.mjs --group pq-faults",
      "reason": "Full native pq-fault-tests variants execute the complete applicable library, including those fault suites."
    },
    {
      "alias": "test:native-scale",
      "command": "node scripts/extended-native-verification.mjs --group scale",
      "reason": "Three named scale routes remain separately executable with fresh evidence roots."
